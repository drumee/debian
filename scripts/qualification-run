#!/usr/bin/env python3
"""Capture Debian qualification commands in the common persistent artifact store."""
import argparse,hashlib,os,pathlib,subprocess,sys
p=argparse.ArgumentParser(description=__doc__);p.add_argument('lot');p.add_argument('execution');p.add_argument('argv',nargs=argparse.REMAINDER);a=p.parse_args()
tool=pathlib.Path(os.environ['DRUMEE_ARTIFACTS_TOOL'])
if not tool.is_absolute() or tool.resolve()!=tool or hashlib.sha256(tool.read_bytes()).hexdigest()!=os.environ['DRUMEE_ARTIFACTS_TOOL_SHA256']:raise SystemExit('ARTIFACT_TOOL_IDENTITY_MISMATCH')
command=a.argv[1:] if a.argv[:1]==['--'] else a.argv
if not command:raise SystemExit('QUALIFICATION_COMMAND_REQUIRED')
run=pathlib.Path.home()/'artifacts/debian'/a.lot/a.execution
if not run.exists():subprocess.run([sys.executable,str(tool),'init','debian',a.lot,a.execution],check=True)
os.execv(sys.executable,[sys.executable,str(tool),'exec','debian',a.lot,a.execution,'--',*command])
