# drumee-web — the first package-based role image.
#
# The whole point: this Dockerfile contains no source checkout, no git clone, no
# webpack, and not one component version. It installs ONE metapackage at an exact
# version and lets dpkg resolve the rest. Compare deploy/docker/Dockerfile.ui, which
# builds from a working tree and runs webpack in the image.
#
#   docker build -f docker/Dockerfile.role-web -t drumee/role-web:<tag> \
#     --build-arg ROLE_VERSION=1.0.29-1~trixie1 .
#
# Build context is the repository root, because the base image and the committed
# keyring both live under docker/.
#
# ROLE_VERSION is required and has no default. A default would be a component version
# written outside release-manifest.yaml, which is the one thing the distribution
# invariants forbid; the caller passes what the manifest says.

# Pinned by DIGEST, with no default for either argument, because a floating tag is the
# thing docs/distribution.md forbids: two builds of the same tag are not the same image.
# The caller resolves the digest — docker/build-role.sh does it by pushing the base to a
# throwaway local registry, since a local-only image has no repo digest to reference
# (measured: `FROM name@<image id>` is rejected for images that were never pushed).
# buildkit warns InvalidDefaultArgInFrom here, because neither ARG has a default and the
# FROM therefore has no valid value on its own. That warning is the POINT and must not be
# "fixed" by adding a default: any default is a floating reference, which is what
# docs/distribution.md §8 rules out. docker/build-role.sh always supplies both.
ARG BASE_IMAGE
ARG BASE_DIGEST
FROM ${BASE_IMAGE}@${BASE_DIGEST}

ARG ROLE_VERSION
ARG APT_URI=https://apt.drumee.net
ARG APT_SUITE=trixie
ARG APT_COMPONENTS=main
ARG APT_KEYRING=drumee-archive-keyring.gpg
# Set by docker/build-role.sh when the repository is LOCAL, to a hash of its Release file.
# Iterating re-includes a package at the same version, which leaves this Dockerfile and every
# other build-arg unchanged — so buildx would reuse the apt layer and the new package would
# never reach the image, with the build reporting success. Empty against apt.drumee.net,
# where a version is immutable and the cache is worth keeping.
ARG APT_CACHEBUST=

USER root

# The public half of the archive key, committed rather than fetched — see
# docker/keyrings/README.md. drumee-apt-source refuses to write a stanza whose keyring
# is missing, so an unsigned source cannot be created by accident.
# The whole keyring directory, and a named ARG, so a role can be built against a
# repository signed by a different key — which is how it gets tested before publishing.
# scripts/apt-repo-local.sh signs with a throwaway key generated on the spot; hardcoding
# the production keyring here meant every local build failed signature verification, and
# the only way to iterate was to publish. All of these are PUBLIC keys.
COPY docker/keyrings/ /usr/share/keyrings/

# One layer: update and install together, because a cached `apt-get update` layer paired
# with a later install resolves against an index that no longer matches the repository.
# --no-install-recommends throughout. The exact-version pin is what makes the image
# reproducible from the manifest alone.
RUN set -eu; \
    : "${ROLE_VERSION:?ROLE_VERSION must be set — see release-manifest.yaml}"; \
    : "${APT_CACHEBUST:-}"; \
    /usr/local/sbin/drumee-apt-source "$APT_URI" "$APT_SUITE" "$APT_COMPONENTS" \
        "/usr/share/keyrings/$APT_KEYRING"; \
    apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends \
        "drumee-role-web=${ROLE_VERSION}" \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

# Recorded in the image so `docker inspect` answers "which release is this" without
# starting it. Read from the anchor package rather than restated, so it cannot disagree.
# nginx's rendered config declares proxy_cache_path /srv/drumee/cache/<domain> and
# CREATES it at startup, so without this directory nginx dies with
# `mkdir() "/srv/drumee/cache/<domain>" failed (2: No such file or directory)` and the
# role crash-loops. Measured against a real rendered tree.
#
# Owned by drumee at build time on purpose: a named volume mounted here inherits the
# ownership of the image directory underneath it, so this is also what makes the volume
# writable by uid 8000. Created here rather than shipped by a package because a cache is
# a runtime artifact, not payload.
# nginx runs as uid 8000 here (§7), not as root-dropping-to-www-data, so every path it
# writes must belong to that uid: its temp trees under /var/lib/nginx and its logs.
# Measured failures without this, in order: mkdir /var/lib/nginx/body (13), then the pid
# file. The pid is redirected by the entrypoint, which is the only one of the three that
# cannot be fixed with ownership.
RUN install -d -o drumee -g drumee -m 0755 /srv/drumee/cache \
 && chown -R drumee:drumee /var/lib/nginx /var/log/nginx \
 && install -o drumee -g drumee -m 0644 /dev/null /run/nginx.pid

RUN . /usr/share/drumee/release \
 && printf '%s\n' "$DRUMEE_RELEASE" > /usr/share/drumee/image-release

LABEL org.opencontainers.image.title="drumee-web" \
      org.opencontainers.image.description="Drumee web role: nginx, LETC bundles, static assets" \
      org.opencontainers.image.source="https://github.com/drumee/debian"

USER drumee
EXPOSE 80 443
# From drumee-bootstrap, not a COPY — §9.2. It validates the configuration, redirects the
# pid away from root-owned /run, and execs nginx in the foreground.
ENTRYPOINT ["/usr/lib/drumee/entrypoint/web"]
