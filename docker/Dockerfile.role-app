# drumee-app — the REST API (24000) and the page/WebSocket server (23000).
#
# One metapackage at an exact version, no source checkout, no clone, no component version
# written here. drumee-role-app pulls drumee-server-pod and drumee-node-runtime; dpkg
# resolves the rest.
#
#   docker/build-role.sh app
#
# It notably does NOT pull drumee-schemas — that dependency was removed at 2.9.99 because
# it dragged mariadb-server into this role, and the database belongs in its own container
# on the official image (§2). The schema is created and migrated by the schemas role.

ARG BASE_IMAGE
ARG BASE_DIGEST
FROM ${BASE_IMAGE}@${BASE_DIGEST}

ARG ROLE_VERSION
ARG APT_URI=https://apt.drumee.net
ARG APT_SUITE=trixie
ARG APT_COMPONENTS=main
ARG APT_KEYRING=drumee-archive-keyring.gpg
# Set by docker/build-role.sh when the repository is LOCAL, to a hash of its Release file.
# Iterating re-includes a package at the same version, which leaves this Dockerfile and every
# other build-arg unchanged — so buildx would reuse the apt layer and the new package would
# never reach the image, with the build reporting success. Empty against apt.drumee.net,
# where a version is immutable and the cache is worth keeping.
ARG APT_CACHEBUST=

USER root

COPY docker/keyrings/ /usr/share/keyrings/

RUN set -eu; \
    : "${ROLE_VERSION:?ROLE_VERSION must be set — see release-manifest.yaml}"; \
    : "${APT_CACHEBUST:-}"; \
    /usr/local/sbin/drumee-apt-source "$APT_URI" "$APT_SUITE" "$APT_COMPONENTS" \
        "/usr/share/keyrings/$APT_KEYRING"; \
    apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends \
        "drumee-role-app=${ROLE_VERSION}" \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

# pm2 writes its own state and logs, and the app writes the runtime tmp tree. All of it
# belongs to uid 8000 (§7) — the same lesson the web role taught with /var/lib/nginx:
# a role that does not run as root must own every path it writes, or it crash-loops on
# the first write with no clue in the logs about which path.
# No /etc/drumee/credential here any more: this role does not write credentials. It used
# to, from a writable volume mounted over the read-only config tree — which needed this
# directory to exist so the fresh volume would inherit uid 8000 — and that arrangement both
# created a second writer and hid infra-init's own email.json and postfix.json behind the
# mount. The credentials now arrive in the shared tree, read-only, with one writer.
RUN install -d -o drumee -g drumee -m 0755 \
        /srv/drumee/runtime/tmp \
        /srv/drumee/cache \
        /var/log/drumee \
 && chown -R drumee:drumee /srv/drumee/runtime/server 2>/dev/null || true

# /data/mfs and /data/tmp owned by drumee at build time. A fresh named volume inherits the
# ownership of the image directory underneath it, so without these the mount arrives
# root-owned and the process running as uid 8000 cannot write: populate died with
# `EACCES: permission denied, mkdir '/data/mfs/238b/...'` after having already stocked the
# entity pool. Third instance of this same rule in this tree (see /etc/drumee/credential in
# the app role and /srv/drumee/cache in the web role).
RUN install -d -o drumee -g drumee -m 0755 /data /data/mfs /data/tmp

RUN . /usr/share/drumee/release \
 && printf '%s\n' "$DRUMEE_RELEASE" > /usr/share/drumee/image-release

LABEL org.opencontainers.image.title="drumee-app" \
      org.opencontainers.image.description="Drumee application role: REST API and page/WebSocket server under pm2" \
      org.opencontainers.image.source="https://github.com/drumee/debian"

USER drumee
EXPOSE 23000 24000
# From drumee-bootstrap, not a COPY — §9.2. It writes the credentials from the
# environment, checks the pm2 ecosystem infra-init rendered, and execs pm2-runtime.
ENTRYPOINT ["/usr/lib/drumee/entrypoint/app"]
