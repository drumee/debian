# Drumee base image — the thin runtime every role image starts from.
#
#   docker buildx build --platform linux/amd64,linux/arm64 \
#     -f docker/Dockerfile.base -t drumee-base:test .
#
# Two host prerequisites for that command, neither of which the Dockerfile can
# supply:
#   * a buildx builder on the docker-container driver — the default `docker`
#     driver answers "Multi-platform build is not supported";
#   * QEMU binfmt handlers for the non-native architecture:
#         docker run --privileged --rm tonistiigi/binfmt --install arm64
#     (privileged, because it registers handlers in the host kernel).
# A multi-platform result is a manifest list and cannot be --load'ed into the
# local image store; push it, or write it with --output=type=oci,dest=…
#
# Verified on both architectures: the OCI output carries linux/amd64 and
# linux/arm64, and on the arm64 image under emulation `id drumee` gives uid=8000
# and policy-rc.d exits 101. Note that `docker run --platform` rejects a
# name:tag@digest reference ("cannot overwrite digest") — use the tag.
#
# It contains no Drumee code. Its whole job is to make `apt-get install
# drumee-role-<x>=<version>` behave correctly inside a container:
#
#   * service starts are refused, so maintainer scripts stay inert (§5)
#   * the runtime identity is fixed, so a shared volume has one owner (§7)
#   * repository keys are present and committed, never fetched (§4)
#
# Build context is the repository root, because the keyrings live in
# docker/keyrings/.

# Pinned by digest, not by tag: a tag is a moving target and two builds of the
# same Dockerfile would then differ with nothing recording why (§1). Resolved with
# `docker buildx imagetools inspect debian:trixie-slim`; it is a manifest list, so
# the same digest serves amd64 and arm64.
FROM debian:trixie-slim@sha256:020c0d20b9880058cbe785a9db107156c3c75c2ac944a6aa7ab59f2add76a7bd

# Drumee's maintainer scripts legitimately reconfigure a host — nginx, TLS, DNS,
# the database. None of that exists during an image build, and half of it would
# bake machine-specific state into the image. Exit 101 is invoke-rc.d's "action
# not allowed", so every service start is refused rather than failing noisily.
# Written FIRST, before any apt-get install can trigger one.
RUN set -eu; \
    printf '#!/bin/sh\nexit 101\n' > /usr/sbin/policy-rc.d; \
    chmod 0755 /usr/sbin/policy-rc.d

# Recommends off globally, as well as per-command. The invariant is checked on
# each apt-get install line, but a package installed by a maintainer script does
# not go through one — this catches those too.
RUN set -eu; \
    printf 'APT::Install-Recommends "false";\nAPT::Install-Suggests "false";\n' \
      > /etc/apt/apt.conf.d/99drumee-no-recommends

# Fixed UID and GID, defined here and nowhere else. The MFS data volume and the
# rendered configuration volume are shared between the app, media and web
# containers; if each image let adduser pick the next free id, the same file would
# be owned by a different user in each one (§7).
ARG DRUMEE_UID=8000
ARG DRUMEE_GID=8000
RUN set -eu; \
    groupadd --system --gid "$DRUMEE_GID" drumee; \
    useradd --system --uid "$DRUMEE_UID" --gid "$DRUMEE_GID" \
            --home-dir /var/lib/drumee --create-home \
            --shell /usr/sbin/nologin --comment "Drumee runtime" drumee; \
    install -d -o drumee -g drumee -m 0755 /var/lib/drumee /etc/drumee

# apt-get update and install in ONE layer: separated, the cached index of an
# earlier layer can be reused against a later install and resolve to packages
# that are no longer in it.
RUN set -eu; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      ca-certificates \
      tzdata \
      curl \
      ; \
    rm -rf /var/lib/apt/lists/*

# Committed, not fetched — see docker/keyrings/README.md for why, and for the
# recorded fingerprint.
COPY docker/keyrings/nodesource.gpg /usr/share/keyrings/nodesource.gpg

# Trixie ships nodejs 20.19.2, but drumee-node-runtime and drumee-role-app require
# nodejs (>= 22), so the NodeSource suite is configured here (§9.5). The repository
# is configured, not installed from: only the roles that need Node pull it in, via
# their dependencies.
RUN set -eu; \
    printf 'Types: deb\nURIs: https://deb.nodesource.com/node_22.x\nSuites: nodistro\nComponents: main\nSigned-By: /usr/share/keyrings/nodesource.gpg\n' \
      > /etc/apt/sources.list.d/nodesource.sources

# The helper that writes the Drumee APT stanza, copied in rather than generated by
# a heredoc: as a committed file it is covered by ShellCheck like every other
# script here. See docker/keyrings/README.md for why no Drumee source is
# configured at this layer.
COPY docker/drumee-apt-source.sh /usr/local/sbin/drumee-apt-source
RUN chmod 0755 /usr/local/sbin/drumee-apt-source

LABEL org.opencontainers.image.title="drumee-base" \
      org.opencontainers.image.description="Thin Debian Trixie runtime for Drumee role images" \
      org.opencontainers.image.source="https://github.com/drumee/debian" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later"

# Roles override this. Declared so an image that forgets to fails visibly rather
# than dropping into a shell as root.
USER drumee
CMD ["/bin/false"]
