#!/bin/bash
source /etc/drumee/drumee.sh
if [ ! -d $DRUMEE_SERVER_HOME ]; then
  echo "DRUMEE_SERVER_HOME is not set"
  exit 1
fi
if [ -z $DRUMEE_SYSTEM_USER ]; then
  DRUMEE_SYSTEM_USER=www-data
fi


: "${DRUMEE_SYSTEM_GROUP:=$DRUMEE_SYSTEM_USER}"

# setpriv, not su. `su` goes through pam_systemd, which registers a LOGIN SESSION and
# moves pm2 into /user.slice/user-<uid>.slice/session-cN.scope — outside the cgroup of
# whatever started it. Measured on a real box, from a service context:
#
#   su      -> 0::/user.slice/user-33.slice/session-c3.scope
#   setpriv -> 0::/system.slice/<unit>.service
#
# That escape is what hung shutdown. The session scope is not ordered against
# drumee-server-pod.service, so systemd tore it down first — killing the pm2 God
# daemon and every worker — and the unit's ExecStop then asked a dead pm2 to stop and
# blocked for the full TimeoutStopSec:
#
#   session-c2.scope: Killing process 7932 (PM2 v5.4.3: God) with signal SIGTERM
#   Stopping drumee-server-pod.service...                    (46ms later)
#   drumee-server-pod.service: Stopping timed out. Terminating.   (90s later)
#
# setpriv drops privilege without a PAM session, so pm2 stays in the caller's cgroup:
# under systemd that is the unit's own, which is what makes the unit's KillMode and
# its ExecStop meaningful. Interactive use (`sudo drumee restart`) is unaffected —
# privileges are dropped exactly as before.
#
# env does the PATH lookup for pm2, since setpriv execs directly without a shell.
manager() {
  if [ -d $DRUMEE_LOG_DIR ]; then
    setpriv --reuid "$DRUMEE_SYSTEM_USER" --regid "$DRUMEE_SYSTEM_GROUP" --init-groups \
      env "HOME=$DRUMEE_SERVER_HOME" pm2 -o "$DRUMEE_LOG_DIR/out.log" -e "$DRUMEE_LOG_DIR/err.log" "$@"
  else
    setpriv --reuid "$DRUMEE_SYSTEM_USER" --regid "$DRUMEE_SYSTEM_GROUP" --init-groups \
      env "HOME=$DRUMEE_SERVER_HOME" pm2 "$@"
  fi
}

cd $DRUMEE_SERVER_HOME
case "$1" in
start)
  if [ ! -d $DRUMEE_LOG_DIR ]; then
    mkdir -p $DRUMEE_LOG_DIR
    chown -R $DRUMEE_SYSTEM_USER:$DRUMEE_SYSTEM_GROUP $DRUMEE_LOG_DIR
  fi
  if [ -z $2 ]; then
    manager start ecosystem.config.js
  else
    manager start ecosystem.config.js --only $2
  fi
  ;;
restart | stop)
  if [ -z $2 ]; then
    manager $1 all
  else
    manager $1 $2
  fi
  ;;
delete | show | monitor | status)
  if [ -z $2 ]; then
    echo "$0 $1 : name or id must be specified"
  else
    manager $1 $2
  fi
  ;;
monit | dash | list)
  manager $1
  ;;
log)
  if [ -z $2 ]; then
    manager $1 production
  else
    manager $1 $2
  fi
  ;;
*)
  manager $*
  ;;
esac
exit 0
