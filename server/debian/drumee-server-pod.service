[Unit]
Description=Drumee Infrastructure
Documentation=man:drumee(1)
After=nginx.service

[Service]
# ExecStart hands off to pm2 and returns immediately — the supervisor and the node
# processes it spawns are what actually stay alive. With the default
# RemainAfterExit=no systemd therefore concluded the service had finished the
# instant the script exited ("Deactivated successfully" in the journal), and
# KillMode then tore down the cgroup, killing the pm2 daemon it had just started.
# `systemctl start drumee-server-pod` could never work, and because the unit is
# WantedBy=multi-user.target the stack did not come up after a reboot either.
# Running the identical init script from a shell worked, purely because it landed
# outside the unit's cgroup — which is what made this look like a script problem
# rather than a unit problem.
#
# oneshot + RemainAfterExit keeps the unit "active (exited)" with the pm2
# processes alive in its cgroup, so stop and reboot still run ExecStop.
Type=oneshot
RemainAfterExit=yes
# /usr/sbin/drumee, not /etc/init.d/drumee: the identical script used to be shipped
# at both paths, and the one under /etc/init.d had no unit of the same name, so
# systemd-sysv-generator built a duplicate drumee.service out of it that fought this
# unit over the same pm2 daemon and hung shutdown for its full 5-minute timeout.
ExecStart=/usr/sbin/drumee start
ExecReload=/usr/sbin/drumee reload
ExecStop=-/usr/sbin/drumee stop
# Applies on stop only, now that ExecStart returning is no longer treated as the
# service ending: ExecStop asks pm2 to shut down, then anything left in the cgroup
# is cleaned up.
KillMode=mixed
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
