#!/bin/sh
# debconf config script for drumee-infra.
# Asks the infrastructure questions (domain, admin, paths, TLS). Preseeded answers
# (debconf-set-selections / install.conf from `render.mjs debconf`) are used as-is;
# only unanswered questions are prompted. The postinst then bridges the answers
# into the DRUMEE_* environment variables that setup-infra/infra.js reads.
set -e
. /usr/share/debconf/confmodule

# Ask FIRST whether an already-configured host should be re-rendered at all, since
# it decides what the rest of this is for. Only asked when there is something to
# lose: /etc/drumee/drumee.json naming a non-empty domain is what infra.js itself
# treats as "already installed" (hasExistingSettings), so the question appears
# exactly when infra.js would otherwise refuse to write.
#
# Fresh installs never see it, and the default is false, so an unattended upgrade
# leaves a running configuration alone unless the answer was preseeded.
if [ -f /etc/drumee/drumee.json ] \
   && grep -qE '"domain_name"[[:space:]]*:[[:space:]]*"[^"]+"' /etc/drumee/drumee.json 2>/dev/null; then
  db_input high drumee-infra/reconfigure_existing || true
  db_go || true
fi

db_input high drumee-infra/description || true
db_input high drumee-infra/domain || true
db_go || true

db_get drumee-infra/domain || true
if [ "$RET" = "local" ]; then
  db_input high drumee-infra/local_mode || true
else
  db_input medium drumee-infra/service || true
fi
db_go || true

db_input high drumee-infra/admin_email || true
db_go || true

db_input medium drumee-infra/db_dir || true
db_input medium drumee-infra/data_dir || true
db_input medium drumee-infra/backup_location || true
db_input medium drumee-infra/exchange_location || true
db_go || true

# TLS. Only asked for a public instance: a local_mode box has no domain to
# certify and takes the self-signed path.
#
# db_set, not just a shell variable: the postinst reads the answer back from
# debconf, and an unanswered tls_method reads as its template default
# (acme-dns-server). A local_mode install therefore arrived in the postinst
# claiming to want ACME against a delegated public zone — the opposite of what
# was chosen here. Writing the answer makes the two scripts agree, which now
# also decides whether a local DNS server is deployed.
tls_method=self-signed
db_get drumee-infra/local_mode || true
if [ "$RET" != "true" ]; then
  db_input high drumee-infra/tls_method || true
  db_go || true
  db_get drumee-infra/tls_method || true; tls_method="$RET"
else
  db_set drumee-infra/tls_method self-signed || true
fi

# An old preseed that only knows own_ssl still selects the "own" path.
db_get drumee-infra/own_ssl || true
[ "$RET" = "true" ] && tls_method=own

case "$tls_method" in
  own)
    db_input high drumee-infra/own_ssl_path || true
    db_go || true
    ;;
  acme-dns-api)
    db_input high drumee-infra/acme_env_file || true
    db_go || true
    ;;
  caddy)
    # Caddy issues over DNS-01 with its compiled-in provider module, so it needs
    # the zone and the provider's credentials. Default the zone to this instance.
    db_get drumee-infra/caddy_domain || true
    if [ -z "$RET" ]; then
      db_get drumee-infra/domain || true
      [ -n "$RET" ] && db_set drumee-infra/caddy_domain "$RET" || true
    fi
    db_input high drumee-infra/caddy_domain || true
    db_input high drumee-infra/caddy_dns_provider || true
    db_input high drumee-infra/caddy_dns_api_key || true
    db_go || true
    ;;
esac

# ACME account email — only meaningful when a certificate is actually issued.
case "$tls_method" in
  acme-*|caddy)
    # default the ACME account to the admin email
    db_get drumee-infra/admin_email || true
    [ -n "$RET" ] && db_set drumee-infra/acme_email "$RET" || true
    db_input high drumee-infra/acme_email || true
    db_go || true
    ;;
esac

# WireGuard peer coordination. Only asked for non-local instances: in local
# mode the node is reachable on the LAN and NAT traversal is pointless.
db_get drumee-infra/local_mode || true
if [ "$RET" != "true" ]; then
  db_input medium drumee-infra/wireguard_enabled || true
  db_go || true
  db_get drumee-infra/wireguard_enabled || true
  if [ "$RET" = "true" ]; then
    db_input medium drumee-infra/wireguard_coordinator || true
    db_input low drumee-infra/wireguard_listen_port || true
    db_input low drumee-infra/wireguard_reflector_port || true
    db_go || true
  fi
fi

exit 0
