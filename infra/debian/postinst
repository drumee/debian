#!/bin/sh
# postinst script for drumee-infra
#
# see: dh_installdeb(1)

set -e

# Source debconf FIRST, before any argument handling: confmodule may re-exec this
# script to connect to the debconf frontend, and doing that after `case "$1"`
# would lose the action argument ("postinst called with unknown argument ''").
. /usr/share/debconf/confmodule

# summary of how this script can be called:
#        * <postinst> `configure' <most-recently-configured-version>
#        * <old-postinst> `abort-upgrade' <new version>
#        * <conflictor's-postinst> `abort-remove' `in-favour' <package>
#          <new-version>
#        * <postinst> `abort-remove'
#        * <deconfigured's-postinst> `abort-deconfigure' `in-favour'
#          <failed-install-package> <version> `removing'
#          <conflicting-package> <version>
# for details, see https://www.debian.org/doc/debian-policy/ or
# the debian-policy package

# Bridge the debconf answers (drumee-infra/*) into the DRUMEE_* environment
# variables that setup-infra/infra.js reads. Without this, infra.js gets an
# empty domain and silently exit(0)s, so `apt install drumee` (+ preseed) never
# configures. This mirrors the drumee-bootstrap wizard (setup/menu/install.sh).
bridge_debconf_env() {
    # confmodule is already sourced at the top of the script.
    db_get drumee-infra/description      || true; export DRUMEE_DESCRIPTION="$RET"
    db_get drumee-infra/domain           || true; export DRUMEE_DOMAIN_NAME="$RET"
    # Whether the domain was ever actually answered, read HERE and exported, because
    # every debconf command must happen inside the session this function opens and
    # closes with db_stop below. Asking afterwards blocks forever waiting for a reply
    # on a closed connection — which is exactly what happened when this check lived
    # in the configure arm: it hung every configure of 1.2.17, fresh or upgrade, with
    # the postinst asleep on a pipe and no child process to show why.
    RET=""
    db_fget drumee-infra/domain seen 2>/dev/null || RET=""
    export DRUMEE_DOMAIN_SEEN="$RET"
    db_get drumee-infra/local_mode       || true; export LOCAL_MODE="$RET"
    # infra.js refuses to re-render a host that is already configured, so without
    # this an upgrade installs new templates and applies none of them. The debconf
    # question is only asked when there is an existing instance, and defaults to
    # false, so this stays unset on fresh installs and on upgrades nobody agreed to
    # re-render. Safe to offer at all only because the secrets on the host are now
    # reused rather than regenerated.
    # RET is cleared first because `db_get X || true` leaves the PREVIOUS question's
    # value in RET when X is unknown to debconf — it does not clear it. A template
    # that failed to register would then be read as whatever was queried just above
    # (local_mode, i.e. "false" here, but the coupling is the bug). Seen for real:
    # a stale debconf frontend held config.dat during an upgrade's unpack, the new
    # template never registered, and this query then blocked the postinst outright.
    RET=""
    db_get drumee-infra/reconfigure_existing 2>/dev/null || RET=""
    if [ "$RET" = "true" ]; then
        export DRUMEE_RECONFIGURE=1
        echo "drumee-infra: re-rendering the configuration of this existing instance."
        echo "  Hand edits under /etc/drumee, /etc/nginx, /etc/bind, Prosody and Postfix"
        echo "  are replaced by the rendered versions. Existing passwords are kept."
    fi
    db_get drumee-infra/service          || true; export SERVICES="$RET"
    db_get drumee-infra/admin_email      || true; export ADMIN_EMAIL="$RET"
    db_get drumee-infra/acme_email       || true; export ACME_EMAIL_ACCOUNT="$RET"
    db_get drumee-infra/db_dir           || true; export DRUMEE_DB_DIR="$RET"
    db_get drumee-infra/data_dir         || true; export DRUMEE_DATA_DIR="$RET"
    db_get drumee-infra/backup_location  || true; export BACKUP_LOCATION="$RET"
    db_get drumee-infra/exchange_location|| true; export EXCHANGE_LOCATION="$RET"
    # Public addresses. The select answer *is* the address unless it reads
    # "other", in which case the free-text answer carries it — same shape as the
    # wizard (setup/menu/install.sh). render.mjs preseeds the pair only when
    # drumee.yaml pins an explicit address; with `network.ip4: auto` nothing is
    # preseeded, both stay empty, and infra.js behaves as before. Without this,
    # a pinned address reached debconf and was dropped here, leaving
    # data.public_ip4 empty so infra.js skipped the whole public branch (nginx
    # 01-public.conf, the BIND public/reverse zones, and postfix/opendkim).
    # No db_get inside $(...) — confmodule speaks the debconf protocol over
    # stdout, and a command substitution would capture it instead.
    db_get drumee-infra/ip4 || true; PUBLIC_IP4="$RET"
    if [ "$PUBLIC_IP4" = "other" ]; then db_get drumee-infra/public_ip4 || true; PUBLIC_IP4="$RET"; fi
    export PUBLIC_IP4
    db_get drumee-infra/ip6 || true; PUBLIC_IP6="$RET"
    if [ "$PUBLIC_IP6" = "other" ]; then db_get drumee-infra/public_ip6 || true; PUBLIC_IP6="$RET"; fi
    export PUBLIC_IP6
    # TLS. setup-infra never uses an HTTP-01 challenge: bin/init-acme always
    # issues a wildcard (-d $dom -d *.$dom --dns <method>), which DNS-01 alone
    # can satisfy. Two variables select between the three paths, and one of them
    # also decides whether a local DNS server is installed at all
    # (setup-infra/bin/install: init-named runs only when ACME_ENV_FILE is unset
    # or points at a missing file):
    #   OWN_SSL       set -> skip ACME entirely, use the operator's certs
    #   ACME_ENV_FILE set -> skip BIND9, issue via dns_$ACME_PROVIDER (outbound
    #                        only, so this is the variant that works behind NAT)
    #   neither       -> install BIND9 and issue via dns_nsupdate against it
    OWN_SSL=""
    ACME_ENV_FILE=""
    db_get drumee-infra/tls_method || true; TLS_METHOD="${RET:-acme-dns-server}"
    # An old preseed may only carry own_ssl; honour it whatever tls_method says.
    db_get drumee-infra/own_ssl || true
    [ "$RET" = "true" ] && TLS_METHOD=own
    case "$TLS_METHOD" in
        own)
            db_get drumee-infra/own_ssl_path || true; OWN_SSL="$RET"
            if [ -z "$OWN_SSL" ]; then
                echo "drumee-infra: tls_method=own but own_ssl_path is empty." >&2
                echo "  Set it (dpkg-reconfigure drumee-infra) or nginx will have no certificate." >&2
            fi
            ;;
        caddy)
            # Caddy terminates TLS itself and therefore must own 80/443, so nginx
            # moves to internal ports. It obtains certificates over DNS-01 with
            # the provider module the drumee-caddy binary was compiled with —
            # which is also why a wildcard is possible here.
            db_get drumee-infra/caddy_domain       || true; CADDY_DOMAIN="${RET:-$DRUMEE_DOMAIN_NAME}"
            db_get drumee-infra/caddy_dns_provider || true; CADDY_DNS_PROVIDER="$RET"
            db_get drumee-infra/caddy_dns_api_key  || true; CADDY_DNS_API_KEY="$RET"
            if [ ! -x /usr/sbin/drumee-caddy ] && ! command -v caddy >/dev/null 2>&1; then
                # Refuse rather than hand nginx's ports to something absent: the
                # box would end up with nothing listening on 443 at all.
                echo "drumee-infra: tls_method=caddy but no Caddy binary found." >&2
                echo "  Install the drumee-caddy package, then: dpkg-reconfigure drumee-infra" >&2
                echo "  Keeping nginx on 80/443 and skipping certificate setup for now." >&2
                TLS_METHOD=caddy-unavailable
            elif [ -z "$CADDY_DNS_PROVIDER" ]; then
                echo "drumee-infra: tls_method=caddy needs a DNS provider module." >&2
                echo "  Set drumee-infra/caddy_dns_provider (dpkg-reconfigure drumee-infra)." >&2
                TLS_METHOD=caddy-unavailable
            else
                # nginx keeps serving the app, behind Caddy. One variable moves
                # every nginx listener: infra.js derives both http_port and
                # public_http_port from DRUMEE_HTTP_PORT. Resolve the ports BEFORE
                # writing caddy.json so both sides name the same upstream.
                DRUMEE_HTTP_PORT="${DRUMEE_HTTP_PORT:-8080}"
                DRUMEE_HTTPS_PORT="${DRUMEE_HTTPS_PORT:-8443}"
                export DRUMEE_HTTP_PORT DRUMEE_HTTPS_PORT
                setup_caddy
                # Certificates belong to Caddy; keep acme.sh and BIND9 out of it.
                OWN_SSL="$CADDY_CERTS_DIR"
                echo "Caddy will terminate TLS for $CADDY_DOMAIN via dns/$CADDY_DNS_PROVIDER"
                echo "  nginx moved to http/$DRUMEE_HTTP_PORT https/$DRUMEE_HTTPS_PORT"
            fi
            ;;
        self-signed)
            # setup-infra derives a private domain and always self-signs it, but
            # it has no "public domain without ACME" mode: infra.js sets
            # PUBLIC_DOMAIN from DRUMEE_DOMAIN_NAME and bin/install then runs
            # init-acme whenever OWN_CERTS_DIR is empty. Say so instead of
            # implying the answer suppressed issuance.
            if [ "$LOCAL_MODE" != "true" ]; then
                echo "drumee-infra: tls_method=self-signed on a public domain ($DRUMEE_DOMAIN_NAME)." >&2
                echo "  A certificate will still be requested for it. Use tls_method=own to supply" >&2
                echo "  your own, or install with domain=local for a LAN-only instance." >&2
            fi
            ;;
        acme-dns-api)
            db_get drumee-infra/acme_env_file || true; ACME_ENV_FILE="$RET"
            # setup-infra tests for the file's existence, and silently installs a
            # local DNS server instead when it is absent — which cannot validate
            # from behind a router. Say so now rather than let it fail at issuance.
            if [ ! -f "$ACME_ENV_FILE" ]; then
                echo "drumee-infra: DNS-API credentials file not found: $ACME_ENV_FILE" >&2
                echo "  Falling back to a local DNS server (needs inbound udp/53 + NS delegation)." >&2
                echo "  Create the file (export ACME_PROVIDER=... plus its credentials, mode 0600)," >&2
                echo "  then: dpkg-reconfigure drumee-infra" >&2
                ACME_ENV_FILE=""
            fi
            ;;
    esac
    # Does this instance serve its own DNS? setup-infra used to infer that from
    # ACME_ENV_FILE alone, which is only ever about the certificate challenge —
    # so tls_method=own installed a nameserver it had no use for, and a LAN-only
    # instance got one by accident rather than on purpose. Decide it here, from
    # the answer the operator actually gave, and hand bin/install the conclusion
    # in DRUMEE_DNS_SERVER.
    #
    #   acme-dns-server  the DNS-01 challenge is answered by a local, TSIG-signed
    #                    nsupdate — there is no certificate without the zone
    #   self-signed      a LAN instance is the only thing on the network that
    #                    knows its own domain. Without a resolver here, nothing
    #                    resolves it: no browser, no client, not the box itself.
    #                    This is the case that used to render a complete zone
    #                    under /var/lib/bind and then serve none of it.
    #   acme-dns-api |
    #   caddy | own      the zone lives at the operator's provider. Taking udp/53
    #                    to answer for a domain served elsewhere is not neutral.
    case "$TLS_METHOD" in
        acme-dns-server|self-signed) DRUMEE_DNS_SERVER=1 ;;
        *)                           DRUMEE_DNS_SERVER=0 ;;
    esac
    # Local mode implies self-signed whatever tls_method says (debian/config
    # skips the question entirely), and it is the case that needs DNS most.
    [ "$LOCAL_MODE" = "true" ] && DRUMEE_DNS_SERVER=1
    export DRUMEE_DNS_SERVER

    # The method itself, for the decisions that are not reducible to a boolean.
    # setup-infra reads it to skip ACME on the self-signed path (a private domain
    # cannot answer a DNS-01 challenge, so init-acme is minutes of guaranteed
    # failure) and to know that create-local-certs is then the ONLY thing that
    # will certify the public names. Unset keeps the previous behaviour.
    export DRUMEE_TLS_METHOD="$TLS_METHOD"

    # bind9 is Recommends, not Depends — three of the five methods have no use
    # for it. `apt install drumee` pulls it in; --no-install-recommends and
    # `dpkg -i` do not. Say so before the install runs, while the operator can
    # still act on it, rather than leaving them to discover that the name does
    # not resolve.
    if [ "$DRUMEE_DNS_SERVER" = "1" ] && ! command -v named >/dev/null 2>&1; then
        echo "drumee-infra: this instance is meant to serve DNS for $DRUMEE_DOMAIN_NAME," >&2
        echo "  but bind9 is not installed. The zone will be rendered and nothing will" >&2
        echo "  answer for it. To finish:" >&2
        # --force-confnew is not optional here. bind9 ships /etc/bind/named.conf.local
        # as a conffile and setup-infra has already rendered one over it, so a
        # later install stops at a conffile prompt — and on a non-interactive
        # stdin dpkg fails outright with "end of file on stdin at conffile
        # prompt", leaving bind9 unconfigured. Taking the maintainer's file
        # costs nothing: the reconfigure on the next line renders ours back.
        echo "      apt-get install -o Dpkg::Options::=--force-confnew bind9 bind9-utils" >&2
        echo "      dpkg-reconfigure drumee-infra" >&2
    fi

    # Export the name the consumers actually read: OWN_CERTS_DIR.
    #
    # OWN_SSL was exported alone, and nothing anywhere reads it —
    # setup-infra/bin/install tests OWN_CERTS_DIR to decide whether to skip ACME,
    # infra.js takes --own_certs_dir (whose argparse default is the OWN_CERTS_DIR
    # environment variable), and the rendered /etc/drumee/drumee.sh itself does
    # `if [ -d "$OWN_CERTS_DIR" ]` to point ACME_DIR at it. So tls_method=own and
    # tls_method=caddy both silently did nothing of what they promised:
    #
    #   * init-acme ran anyway for the public domain, failing on a domain with no
    #     delegation — invisible, because bin/install runs under `set +e`;
    #   * certs_dir stayed at the default /etc/drumee/certs instead of the
    #     operator's path, so nginx looked for certificates where none had been
    #     put and refused to start;
    #   * PRIVATE_DOMAIN was not nulled (infra.js:49), so a private vhost was
    #     rendered for an instance that had asked for its own certificates.
    #
    # OWN_SSL is kept exported for anything out of tree that may have started
    # depending on it, but OWN_CERTS_DIR is the one that has effect.
    OWN_CERTS_DIR="$OWN_SSL"
    export OWN_SSL OWN_CERTS_DIR ACME_ENV_FILE

    # infra.js only honours the directory when it already exists
    # (`existsSync(args.own_certs_dir)`), and bin/install only skips ACME when the
    # variable is non-empty. A path that is set but absent therefore falls back to
    # requesting a certificate, which is the opposite of what was asked for — so
    # say so instead of letting it fail later at issuance or at nginx start.
    if [ -n "$OWN_CERTS_DIR" ] && [ ! -d "$OWN_CERTS_DIR" ]; then
        echo "drumee-infra: certificate directory does not exist: $OWN_CERTS_DIR" >&2
        echo "  It must exist before this package is configured, or Drumee ignores it," >&2
        echo "  requests a certificate instead, and nginx finds none where it looks." >&2
        echo "  Create it with your wildcard certificates, then: dpkg-reconfigure drumee-infra" >&2
    fi

    echo "TLS method: $TLS_METHOD"
    # WireGuard peer coordination. Defaults mirror debian/templates so an
    # instance preseeded without the wireguard/* keys stays disabled rather
    # than half-configured.
    db_get drumee-infra/wireguard_enabled        || true; export WIREGUARD_ENABLED="${RET:-false}"
    db_get drumee-infra/wireguard_coordinator    || true; export WIREGUARD_COORDINATOR="${RET:-coord.drumee.tech}"
    db_get drumee-infra/wireguard_listen_port    || true; export WIREGUARD_LISTEN_PORT="${RET:-51820}"
    db_get drumee-infra/wireguard_reflector_port || true; export WIREGUARD_REFLECTOR_PORT="${RET:-51821}"
    # Release the debconf channel before the long-running installer.
    db_stop
}

# nginx reads certificates from $CERTS_DIR/<domain>_ecc/<domain>.{cer,key} (the
# acme.sh layout). Caddy exports into that same layout, so nginx needs no change:
# the only thing to suppress is acme.sh also trying to issue.
CADDY_CERTS_DIR=/etc/drumee/certs

# Hand the Caddy half of the configuration to the drumee-caddy package. Written
# here rather than shipped for the same reason as wireguard.json — dpkg would
# treat a shipped file as a conffile and prompt on every upgrade.
#
# CONTRACT with drumee-caddy (keep both sides in sync):
#   reads  /etc/drumee/conf.d/caddy.json        what to serve and how
#          /etc/drumee/credential/caddy-dns.env provider credentials (0600)
#   writes $certs_dir/<domain>_ecc/<domain>.cer and .key after each issuance
#          and renewal, so nginx and prosody/jitsi keep working unchanged
#   owns   ports 80 and 443; proxies to nginx on upstream_http_port
setup_caddy() {
    conf_dir=/etc/drumee/conf.d
    cred_dir=/etc/drumee/credential
    mkdir -p "$conf_dir" "$CADDY_CERTS_DIR"
    install -d -m 0700 "$cred_dir"

    cat > "$conf_dir/caddy.json" <<EOF
{
  "enabled": true,
  "domain": "${CADDY_DOMAIN}",
  "dns_provider": "${CADDY_DNS_PROVIDER}",
  "acme_email": "${ACME_EMAIL_ACCOUNT}",
  "certs_dir": "${CADDY_CERTS_DIR}",
  "upstream_http_port": ${DRUMEE_HTTP_PORT:-8080},
  "upstream_https_port": ${DRUMEE_HTTPS_PORT:-8443}
}
EOF
    chmod 0644 "$conf_dir/caddy.json"

    # The token is a secret: never in conf.d (0644), never echoed back.
    umask 077
    cat > "$cred_dir/caddy-dns.env" <<EOF
# Generated by drumee-infra. Sourced by the drumee-caddy service.
# Providers needing more than one value: add them here.
export DRUMEE_CADDY_DNS_PROVIDER=${CADDY_DNS_PROVIDER}
export DRUMEE_CADDY_DNS_TOKEN=${CADDY_DNS_API_KEY}
EOF
    chmod 0600 "$cred_dir/caddy-dns.env"
    umask 022

    if [ -z "$CADDY_DNS_API_KEY" ]; then
        echo "drumee-infra: no DNS API token given — Caddy cannot issue yet." >&2
        echo "  Add DRUMEE_CADDY_DNS_TOKEN to $cred_dir/caddy-dns.env (0600)," >&2
        echo "  then: systemctl restart drumee-caddy" >&2
    fi
}

# Report on — or stand down — the local nameserver, once setup-infra has had its
# turn at it.
#
# infra.js renders the BIND tree unconditionally, so even a method that keeps its
# zone at a DNS provider ends up with /etc/bind/named.conf.local declaring this
# instance's zone. bind9's own postinst starts named on install, which on such a
# host means one of two bad outcomes: it answers authoritatively for a domain
# served elsewhere, or — since the TSIG key is only generated on the DNS path and
# named.conf.local includes it — it fails to load at all and leaves a failed unit
# behind. Stand it down instead. The marker is what keeps this from touching a
# nameserver that was not put there by Drumee.
DRUMEE_NAMED_MARKER="Configs setup by Drumee setup-infra utility"

finish_dns() {
    command -v named >/dev/null 2>&1 || return 0

    if [ "${DRUMEE_DNS_SERVER:-0}" = "1" ]; then
        # setup-infra/bin/init-named has already validated the config and
        # started the service by this point; only the verdict is left to report.
        #
        # One retry first, because Recommends is not an ordering constraint: on
        # `apt install drumee` apt may configure drumee-infra before bind9, so
        # init-named ran against a nameserver that was unpacked but not yet set
        # up and could not start it. By now bind9's own configure has usually
        # happened, and this is the difference between a working install and a
        # correct-looking one that answers nothing.
        if ! systemctl is-active --quiet named 2>/dev/null; then
            deb-systemd-invoke start named.service >/dev/null 2>&1 || true
        fi
        if systemctl is-active --quiet named 2>/dev/null; then
            echo "DNS: named is authoritative for $DRUMEE_DOMAIN_NAME on this host."
            echo "  Nothing else on the network knows that name yet — point the LAN here,"
            echo "  either through the router's DHCP \"DNS server\" option or per client."
            echo "  Check it with:  dig +short $DRUMEE_DOMAIN_NAME @<this host's address>"
        else
            echo "drumee-infra: named is installed but not running, so $DRUMEE_DOMAIN_NAME" >&2
            echo "  resolves nowhere. See: journalctl -u named -n 50" >&2
        fi
        return 0
    fi

    if grep -qF "$DRUMEE_NAMED_MARKER" /etc/bind/named.conf.local 2>/dev/null; then
        echo "DNS: ${TLS_METHOD:-this TLS method} keeps the zone with your provider — standing named down."
        deb-systemd-invoke stop named.service >/dev/null 2>&1 || true
        systemctl disable named.service >/dev/null 2>&1 || true
    fi
}

# Write /etc/drumee/conf.d/wireguard.json and wire up the units. The file is
# generated here rather than shipped in the package so dpkg never treats it as
# a conffile and never prompts on upgrade.
setup_wireguard() {
    conf_dir=/etc/drumee/conf.d
    mkdir -p "$conf_dir"
    cat > "$conf_dir/wireguard.json" <<EOF
{
  "enabled": ${WIREGUARD_ENABLED},
  "coordinator_host": "${WIREGUARD_COORDINATOR}",
  "reflector_port": ${WIREGUARD_REFLECTOR_PORT},
  "listen_port": ${WIREGUARD_LISTEN_PORT}
}
EOF
    chmod 0644 "$conf_dir/wireguard.json"

    if [ "$WIREGUARD_ENABLED" != "true" ]; then
        echo "WireGuard coordination disabled — units left inactive."
        deb-systemd-invoke stop drumee-wg-agent.service >/dev/null 2>&1 || true
        systemctl disable drumee-wg-agent.service     >/dev/null 2>&1 || true
        systemctl disable drumee-wg-bootstrap.service >/dev/null 2>&1 || true
        return 0
    fi

    # The agent uses the global WebSocket API, stable from Node 22. The package
    # only requires nodejs >= 20 for the rest of the stack, so check explicitly
    # and degrade with a clear message instead of a crash loop at boot.
    node_major=$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)
    if [ "$node_major" -lt 22 ]; then
        echo "drumee-infra: WireGuard agent needs Node >= 22 (found $node_major)." >&2
        echo "  Coordination left disabled. Upgrade Node, then: dpkg-reconfigure drumee-infra" >&2
        sed -i 's/"enabled": true/"enabled": false/' "$conf_dir/wireguard.json"
        return 0
    fi

    echo "Enabling WireGuard peer coordination via ${WIREGUARD_COORDINATOR}"
    systemctl daemon-reload || true
    systemctl enable drumee-wg-bootstrap.service >/dev/null 2>&1 || true
    systemctl enable drumee-wg-agent.service     >/dev/null 2>&1 || true
    deb-systemd-invoke restart drumee-wg-bootstrap.service || true
    deb-systemd-invoke restart drumee-wg-agent.service     || true
}

# Nothing else does this — not this script, and not setup-infra/bin/install (grep
# either for nginx: they write vhosts and never tell nginx about them). nginx's
# own postinst has already started it by the time we are configured, with the
# config that existed *before* the render, so the process stays up with no Drumee
# vhost loaded and the instance serves nothing at all. `systemctl is-active nginx`
# says "active" and `curl` gets connection-refused, because there is no listener:
# an install that reports success and answers on no port.
#
# Found the same way as the certificate bug in 1.2.23 — by wiping a box and
# installing from scratch. Deployments that came up "fine" had all been restarted
# by hand at some point, which is what hid it.
reload_nginx() {
    command -v nginx >/dev/null 2>&1 || return 0

    # Never reload a configuration nginx would reject: a reload failure leaves the
    # old workers serving, which here means still serving nothing, and the reason
    # scrolls past in a postinst nobody re-reads. Say it instead.
    if ! nginx -t >/dev/null 2>&1; then
        echo "drumee-infra: nginx rejected the rendered configuration — not reloading." >&2
        nginx -t 2>&1 | sed 's/^/  /' >&2
        echo "  Fix the reported file, then: systemctl restart nginx" >&2
        return 0
    fi

    # A reload picks up new vhosts, but only if there is a master to signal. On a
    # first install nginx may legitimately be stopped (policy-rc.d, a failed
    # earlier start), and reloading a dead unit is a silent no-op.
    if systemctl is-active --quiet nginx 2>/dev/null; then
        deb-systemd-invoke reload nginx.service >/dev/null 2>&1 \
            || deb-systemd-invoke restart nginx.service >/dev/null 2>&1 || true
        echo "Reloaded nginx with the rendered Drumee vhosts"
    else
        deb-systemd-invoke start nginx.service >/dev/null 2>&1 || true
        echo "Started nginx with the rendered Drumee vhosts"
    fi
}

# setup-infra renders 90-turn-relay.*.conf into /etc/nginx/modules-enabled, which
# Debian's nginx.conf includes at MAIN context, and its content is a `stream {}`
# block. That directive only exists once libnginx-mod-stream's load_module link is
# in place, and Debian's own libnginx-mod-* prerm parks that link as
# `<name>.conf.removed` whenever the module package is removed. Land a stream
# block while the link is parked and nginx refuses its entire configuration:
#
#   nginx: [emerg] unknown directive "stream" in
#          /etc/nginx/modules-enabled/90-turn-relay.public.conf:15
#
# We Depends on libnginx-mod-stream, but a dependency is not a guarantee that its
# link is enabled *now*: dpkg configures nginx before libnginx-mod-stream (the
# nginx-abi-* virtual package makes nginx the prerequisite), so `nginx -t` runs
# during nginx's own postinst while the module is still parked. Restore the link
# before anything renders a stream block, rather than after nginx has already
# rejected it.
ensure_nginx_stream_module() {
    parked=/etc/nginx/modules-enabled/50-mod-stream.conf.removed
    [ -L "$parked" ] || return 0
    if mv "$parked" /etc/nginx/modules-enabled/50-mod-stream.conf; then
        echo "drumee-infra: re-enabled nginx stream module (was parked as .removed)"
    fi
}

case "$1" in
    configure)
    echo "Configuring Drumee Infrastructure"
    bridge_debconf_env
    ensure_nginx_stream_module
    if [ -z "$DRUMEE_DOMAIN_NAME" ]; then
        echo "drumee-infra: no domain configured (debconf drumee-infra/domain is empty)." >&2
        echo "  Preseed it first, e.g.: debconf-set-selections < install.conf  (from: render.mjs debconf)" >&2
        exit 1
    fi
    # An empty domain was the only thing refused, but debconf's own default is
    # example.com — not empty, so it sailed through and the install completed
    # "successfully" configured for a domain the operator does not own: BIND serving
    # its zone, ACME trying to certify it, every vhost named after it, and (until
    # 1.2.16) nginx refusing to start because the matching address was empty too.
    #
    # Seen for real: a preseed file went missing between a reboot and the install,
    # `debconf-set-selections < missing-file` wrote nothing, and nothing complained.
    #
    # `seen` is the precise signal — debconf sets it when a question is answered,
    # whether by a human or by debconf-set-selections, and it persists across
    # upgrades. So this refuses only a first configure that was never told anything,
    # and never second-guesses an operator who did answer.
    if [ "$DRUMEE_DOMAIN_SEEN" != "true" ]; then
        echo "drumee-infra: the domain question was never answered — refusing to configure on defaults." >&2
        echo "  Falling back would configure this host for '$DRUMEE_DOMAIN_NAME', a placeholder" >&2
        echo "  rather than your domain, and the result looks like a successful install." >&2
        echo "  Preseed it:      debconf-set-selections < install.conf   (from: render.mjs debconf)" >&2
        echo "  or install interactively so the questions are actually asked." >&2
        exit 1
    fi
    /var/lib/drumee/setup-infra/bin/install
    finish_dns
    setup_wireguard
    reload_nginx
    ;;

    reconfigure)
    bridge_debconf_env
    ensure_nginx_stream_module
    # --reconfigure=1, not --force-install=1. setup-infra's hasExistingSettings()
    # gates re-rendering on `args.reconfigure` (templates/utils.js) and its own
    # message says "Use --reconfigure=1"; --force-install was declared but read by
    # nothing. So this arm passed a flag that did nothing: the guard held, infra.js
    # exit(0)'d, dpkg reported success, and NOTHING was re-rendered — which made
    # `dpkg-reconfigure drumee-infra` a silent no-op on exactly the hosts it exists
    # for, and it is the advice every TLS/DNS message in this script gives.
    node /var/lib/drumee/setup-infra/infra.js --reconfigure=1
    # This arm re-renders without going through bin/install, so nothing here
    # would ever (re)start named — and "then: dpkg-reconfigure drumee-infra" is
    # the advice every DNS-related message in this script gives.
    if [ "${DRUMEE_DNS_SERVER:-0}" = "1" ]; then
        /var/lib/drumee/setup-infra/bin/init-named || true
    fi
    finish_dns
    setup_wireguard
    reload_nginx
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;
    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
