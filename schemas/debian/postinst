#!/bin/bash
# postinst script for drumee
#
# see: dh_installdeb(1)

set -e

# summary of how this script can be called:
#        * <postinst> `configure' <most-recently-configured-version>
#        * <old-postinst> `abort-upgrade' <new version>
#        * <conflictor's-postinst> `abort-remove' `in-favour' <package>
#          <new-version>
#        * <postinst> `abort-remove'
#        * <deconfigured's-postinst> `abort-deconfigure' `in-favour'
#          <failed-install-package> <version> `removing'
#          <conflicting-package> <version>
# for details, see https://www.debian.org/doc/debian-policy/ or
# the debian-policy package
# Source debconf library.

case "$1" in
    configure)
    echo "Configuring Drumee Schemas"
    # ---------------------------------------------------------------------------
    # Payload only during an image build — the same flag and the same reason as
    # drumee-infra (docs/distribution.md §5: the package delivers the payload, the job
    # container executes it).
    #
    # bin/install restores a mariabackup PHYSICAL snapshot into /var/lib/mysql with
    # --copy-back, creates the system accounts and sends a welcome email. None of that
    # can or should happen in a `docker build`, and it does not fail quietly: it
    # stopped a MariaDB that was never running, could not find /srv/db or
    # /var/log/drumee, and ended with "FATAL: seed restore (mariabackup --copy-back)
    # failed", taking drumee-role-schemas unconfigured with it. Measured while building
    # that role image.
    #
    # The container channel bootstraps the database logically instead — the base
    # databases from the schemas repo's own templates/factory/ tree, over TCP, from the
    # schemas role's entrypoint — because a physical restore cannot reach a database
    # living in another container.
    # ---------------------------------------------------------------------------
    if [ "${DRUMEE_BUILD_TIME:-0}" = "1" ]; then
        echo "  DRUMEE_BUILD_TIME=1 — delivering the payload only."
        echo "  No seed is restored and no database is touched."
        echo "  The schemas role bootstraps the database at deploy time."
        exit 0
    fi
    /var/lib/drumee/setup-schemas/bin/install

    # Gap #2 guard (docs/native-audit.md): populate.js *consumes* factory-pool
    # entities (drumate_create -> pickupEntity) but never stocks them, so a
    # data-free seed leaves yp.entity(area='pool') empty and the first-run system
    # accounts fail with EMPTY_FACTORY — a silently half-broken install. Detect it
    # and report loudly with the remedy. (root@localhost auths via unix_socket.)
    pool=$(mariadb -N -B -e "SELECT COUNT(*) FROM yp.entity WHERE area='pool'" 2>/dev/null || echo 0)
    # Count by username. yp.drumate has no `category` column and never did, so the
    # previous query failed with ER_BAD_FIELD_ERROR on every run; `2>/dev/null ||
    # echo 0` then turned that error into a plain 0, and the guard fired on EVERY
    # install — reporting "system accounts missing" against a database that held
    # nobody, guest and system all along. Verified on a live install. A guard that
    # cannot pass is worse than no guard: it teaches the operator to ignore it.
    sysacct=$(mariadb -N -B -e \
      "SELECT COUNT(*) FROM yp.drumate WHERE username IN ('nobody','guest','system')" \
      2>/dev/null || echo 0)
    if [ "${pool:-0}" -eq 0 ] || [ "${sysacct:-0}" -eq 0 ]; then
        echo "" >&2
        echo "drumee-schemas: WARNING — factory pool empty / system accounts missing" >&2
        echo "  (pool entities=${pool:-0}, system accounts=${sysacct:-0})." >&2
        echo "  The seed shipped no stocked factory pool, so account creation hit" >&2
        echo "  EMPTY_FACTORY. Remedy: build the seed from a system with a stocked pool," >&2
        echo "  or apply the populate.js stockFactory fix (docs/native-audit.md gap #2)," >&2
        echo "  then re-run:  dpkg-reconfigure drumee-schemas" >&2
        echo "" >&2
    fi
    ;;
    reconfigure)
    echo "NOP"
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;
    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
