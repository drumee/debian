# DEPRECATED — source-based image. See deploy/docker/DEPRECATED.md.
# The build context here is a source checkout; the replacement installs .deb packages
# from apt.drumee.net into docker/Dockerfile.base. Do not add to this file: fixes to
# keep the current stack running are fine, new work belongs in the package-based path.
# Drumee WireGuard coordination agent — container-channel counterpart of the
# drumee-wg-bootstrap/drumee-wg-agent systemd units shipped by drumee-infra.
#
# The bootstrap script and the agent are COPIED FROM THE NATIVE PACKAGE TREE
# (build context `wg` = infra/var/lib/drumee/wireguard) rather than duplicated
# here: both channels must run byte-identical coordination logic, because the
# message protocol is shared with the coord-server repo.
#
#   docker build -f deploy/docker/Dockerfile.wireguard \
#     --build-context wg=infra/var/lib/drumee/wireguard \
#     -t drumee/wireguard:local deploy/docker
#
# Node 22 is required, not merely preferred: the agent uses the global WebSocket
# API. Runtime needs NET_ADMIN and the host network namespace (see the compose
# service rendered by config/render.mjs), plus the `wireguard` kernel module
# loaded on the HOST — a container cannot provide it.
FROM node:22-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      wireguard-tools iproute2 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=wg bootstrap.sh /usr/local/lib/drumee/wireguard/bootstrap.sh
COPY --from=wg agent.js     /usr/local/lib/drumee/wireguard/agent.js
COPY wireguard-entrypoint.sh /usr/local/bin/drumee-wg
RUN chmod 0755 /usr/local/bin/drumee-wg /usr/local/lib/drumee/wireguard/bootstrap.sh

ENTRYPOINT ["/usr/local/bin/drumee-wg"]
