{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drumee.org/config/drumee.minimal-kernel.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "distribution",
    "instance",
    "deployment",
    "network",
    "dns",
    "tls",
    "storage",
    "ports",
    "images",
    "provenance",
    "operator"
  ],
  "properties": {
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile"
      ],
      "properties": {
        "profile": {
          "const": "minimal-kernel"
        }
      }
    },
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain"
      ],
      "properties": {
        "domain": {
          "const": "drumee.lan"
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "project",
        "owner_uid",
        "owner_gid",
        "acceptance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "project": {
          "type": "string",
          "minLength": 1
        },
        "owner_uid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "owner_gid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "acceptance": {
          "type": "boolean"
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interface",
        "lan_address",
        "bind_address",
        "clients"
      ],
      "properties": {
        "interface": {
          "type": "string",
          "minLength": 1
        },
        "lan_address": {
          "type": "string",
          "format": "ipv4"
        },
        "bind_address": {
          "type": "string",
          "format": "ipv4"
        },
        "clients": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "dns": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "const": "local"
        }
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider"
      ],
      "properties": {
        "provider": {
          "const": "local"
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "backup_location",
        "retention_days"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "backup_location": {
          "type": "string",
          "minLength": 1
        },
        "retention_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 36500
        }
      }
    },
    "ports": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "https",
        "dns"
      ],
      "properties": {
        "https": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "dns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kernel",
        "tools"
      ],
      "properties": {
        "kernel": {
          "type": "string",
          "pattern": "^(?:[a-zA-Z0-9._/:/-]+@)?sha256:[a-f0-9]{64}$"
        },
        "tools": {
          "type": "string",
          "pattern": "^(?:[a-zA-Z0-9._/:/-]+@)?sha256:[a-f0-9]{64}$"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "alignment_sha256"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "alignment_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "username",
        "email",
        "operation_id"
      ],
      "properties": {
        "mode": {
          "enum": [
            "interactive",
            "automatic",
            "test"
          ]
        },
        "username": {
          "type": "string",
          "minLength": 1
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "operation_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operator": {
            "properties": {
              "mode": {
                "const": "test"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "deployment": {
            "properties": {
              "acceptance": {
                "const": true
              }
            }
          }
        }
      }
    }
  ]
}
