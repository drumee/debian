# public

# vuepress build output
.vuepress/dist

# vuepress v2.x temp and cache directory
.temp
.cache

# Docusaurus cache and generated files
.docusaurus

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# yarn v2
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# Drumee build artifacts
schemas/seeds/

# Rendered config (may contain pinned secrets) — keep only the example
config/drumee.yaml
/out/

# dpkg-buildpackage / debhelper outputs (regenerated every build, never source)
*/debian/.debhelper/
*/debian/*.debhelper/
*/debian/debhelper-build-stamp
*/debian/*.substvars
*/debian/*.debhelper
*/debian/*.debhelper.log
*/debian/files
builder/tmp/

# Other
._.DS_Store
.DS_Store
.stderr
.tmp*
.sass-cache/
*trash/
git-status.*
*~
.fuse*
build/
t
.dev-tools-rc/*
src/*
# demo stack scratch dir
tests/.demo-run/
out-debs/
release-debs/
apt-repo/

# local APT test repository (contains a generated signing key)
.apt-local/

# generated by roles/build.sh so the source package builds standalone (§4);
# the authoritative copy is the one at the repository root
roles/release-manifest.yaml

# dpkg-buildpackage writes binary artifacts next to the source directory, which
# for roles/ and any future in-repo source package is the repository root
/drumee-*.deb
/drumee-*.buildinfo
/drumee-*.changes
/drumee-*.dsc
/drumee-*.tar.*

# roles/ is built in place (a source package), unlike the other builders which
# stage under <pkg>/build/ — so its debhelper staging output needs ignoring here.
# Trailing slashes: the .install and .lintian-overrides FILES beside them are source.
roles/debian/tmp/
roles/debian/drumee-*/
node-runtime/build/
node-runtime/node_modules/
bootstrap/build/

# pool/dists repository staged by scripts/publish-pool.sh
apt-pool/
