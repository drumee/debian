#!/bin/sh
# infra role: run-once. Renders the configuration tree the other roles mount, then exits.
# Writes only into its output directory — never onto a host (§5).
#
# It renders by RECONFIGURING THE PACKAGE, not by calling infra.js directly:
#
#   debconf-set-selections < install.conf
#   DEBCONF_RECONFIGURE=1 DRUMEE_CHROOT=$OUT dpkg-reconfigure drumee-infra
#
# so the container channel walks exactly the path the native channel walks on every
# install — the same preseed file, the same debconf→DRUMEE_* bridge in drumee-infra's
# postinst, the same bin/install, the same renderers.
#
# docs/channel-parity.md has the argument; the short version is that this script used to
# hand-map environment variables onto infra.js flags, and every container-side
# configuration bug came from that second mapping: a BIND zone file literally named
# `auto`, "domain_name": "localhost" in one file and the real domain in another, an
# argparse usage dump because --admin-email is not an option, and a lost render because a
# DKIM ordering requirement was undocumented. The postinst had none of them, because every
# native install exercises it.
#
# DRUMEE_CHROOT does double duty, deliberately: bin/install turns it into --chroot, and the
# postinst reads it as "this is a render, not a host configure" and skips DNS, WireGuard
# and nginx.
#
# Input:
#   /etc/drumee/install.conf   the preseed, mounted read-only (render.mjs debconf)
#   DRUMEE_INFRA_OUT           render target, default /out
#   FORCE_RENDER=1             re-render over an existing tree
#   DB_HOST/DB_PORT/DB_USER/DB_PASSWORD, REDIS_HOST/REDIS_PORT/REDIS_PASSWORD
#                              the deployment's credentials. NOT Drumee-semantic settings —
#                              those come from the preseed. These are secrets shared with
#                              the official mariadb and redis images, which are initialised
#                              from the same .env, so .env is their authority and the
#                              preseed is not (debconf would also store them in plaintext
#                              in config.dat). infra.js honours DB_* when it renders
#                              db.json; redis.json is written below.
#
# Domain, addresses, TLS method, directories and WireGuard all come from the preseed. There
# is deliberately no environment fallback for them: a second way to say the same thing is
# what this replaced.
set -eu
. /usr/lib/drumee/entrypoint/lib.sh
drumee_release

OUT="${DRUMEE_INFRA_OUT:-/out}"
PRESEED="${DRUMEE_PRESEED:-/etc/drumee/install.conf}"
SETUP=/var/lib/drumee/setup-infra
UID_DRUMEE="${DRUMEE_UID:-8000}"
GID_DRUMEE="${DRUMEE_GID:-8000}"

[ -d "$SETUP" ] || die "$SETUP not found (drumee-infra provides it)"
command -v node >/dev/null || die "node not found"
command -v debconf-set-selections >/dev/null || die "debconf-set-selections not found"
[ -d "$OUT" ] || die "$OUT is not mounted — the shared configuration volume must be there"
[ -f "$PRESEED" ] || die "no preseed at $PRESEED — generate it with: render.mjs debconf"

# Idempotence is infra.js's own: hasExistingSettings() sees the drumee.json a previous run
# wrote and exits without touching anything unless --reconfigure=1. A restarted job is a
# no-op and a deliberate re-render is one flag — the same contract as dpkg-reconfigure
# natively, which is now literally the same code path.
if [ "${FORCE_RENDER:-0}" != "1" ] && [ -f "$OUT/etc/drumee/drumee.json" ]; then
  echo "[drumee] already rendered ($OUT/etc/drumee/drumee.json exists) — nothing to do"
  echo "[drumee] set FORCE_RENDER=1 to render again"
  exit 0
fi

echo "[drumee] preseeding debconf from $PRESEED"
debconf-set-selections < "$PRESEED"

# The domain is read back FROM DEBCONF rather than from the environment, so this script has
# exactly one source of truth for it — the same one the postinst will use.
DOMAIN="$(echo get drumee-infra/domain | debconf-communicate drumee-infra 2>/dev/null | cut -d' ' -f2-)"
[ -n "$DOMAIN" ] || die "the preseed carries no drumee-infra/domain"
echo "[drumee] domain from the preseed: $DOMAIN"

# DKIM before the render: infra.js no longer dies without a key, but the zone embeds the
# public half, so a real key must exist first or the zone advertises nothing.
KEYDIR="$OUT/etc/opendkim/keys/$DOMAIN"
if [ ! -s "$KEYDIR/dkim.txt" ]; then
  if command -v opendkim-genkey >/dev/null 2>&1; then
    echo "[drumee] generating a DKIM key for $DOMAIN"
    mkdir -p "$KEYDIR"
    opendkim-genkey -b 2048 -d "$DOMAIN" -s dkim -D "$KEYDIR"
    chmod 0640 "$KEYDIR/dkim.private"
  else
    echo "[drumee] opendkim-genkey absent — the render will emit an empty DKIM record"
  fi
fi

echo "[drumee] rendering into $OUT via dpkg-reconfigure drumee-infra"
DEBIAN_FRONTEND=noninteractive \
DEBCONF_RECONFIGURE=1 \
DRUMEE_CHROOT="$OUT" \
  dpkg-reconfigure drumee-infra

[ -f "$OUT/etc/drumee/drumee.json" ] \
  || die "the render produced no $OUT/etc/drumee/drumee.json — refusing to report success"

# Self-signed certificates, when nothing else will provide them. nginx in the web role will
# not start without the files its ssl/*.conf includes, so a self-signed deployment needs
# them here — natively bin/install calls create-local-certs at this exact point.
if [ -z "${OWN_CERTS_DIR:-}" ] && [ -f "$SETUP/bin/create-local-certs" ]; then
  echo "[drumee] creating self-signed certificates"
  # The names to sign come from the drumee.sh this render just wrote; CERTS_DIR is
  # re-pointed into the target, because the value in that file is the path the ROLES see
  # once the volume is mounted, not a path in this container. `set +u` because that file is
  # generated per deployment and references variables it does not define.
  ( set +u
    . "$OUT/etc/drumee/drumee.sh"
    CERTS_DIR="$OUT/etc/drumee/certs"; export CERTS_DIR
    cd "$SETUP" && bash bin/create-local-certs
  ) || echo "[drumee] WARNING: create-local-certs failed — the web role may not start" >&2
fi

# redis.json, which the render does not touch: infra.js writes db.json, email.json and
# postfix.json, and drumee-infra SHIPS a redis.json pointing at localhost:6379. Correct on
# one box, wrong where Redis is a container of its own — so the infra job owns this file in
# the container channel. One writer per credential, which is the whole point: the app and
# schemas roles used to write it themselves, from two places, over a rendered tree they
# could not even see.
if [ -n "${REDIS_HOST:-}" ]; then
  echo "[drumee] writing redis.json for ${REDIS_HOST}:${REDIS_PORT:-6379}"
  mkdir -p "$OUT/etc/drumee/credential"
  cat > "$OUT/etc/drumee/credential/redis.json" <<JSON
{
  "redisHost": "${REDIS_HOST}",
  "redisPort": ${REDIS_PORT:-6379},
  "redisAuth": $( [ -n "${REDIS_PASSWORD:-}" ] && printf '"%s"' "$REDIS_PASSWORD" || printf 'null' ),
  "liveUpdateChannel": "${LIVE_UPDATE_CHANNEL:-LIVE_UPDATE_CHANNEL}"
}
JSON
fi

# The other roles run as uid 8000 and only read this tree. Credentials stay 0640 inside a
# 0750 directory: db.json and email.json carry passwords, and this volume is shared with the
# media role — the one component that parses untrusted documents.
echo "[drumee] fixing ownership to $UID_DRUMEE:$GID_DRUMEE"
chown -R "$UID_DRUMEE:$GID_DRUMEE" "$OUT"
[ -d "$OUT/etc/drumee/credential" ] && chmod 0750 "$OUT/etc/drumee/credential"
find "$OUT/etc/drumee/credential" -type f -exec chmod 0640 {} + 2>/dev/null || true

echo "[drumee] done — $(find "$OUT" -type f | wc -l) files"
printf '[drumee]   %-14s %s\n' domain "$(grep -oE '"domain_name": "[^"]*"' "$OUT/etc/drumee/drumee.json" || echo '?')"
printf '[drumee]   %-14s %s\n' nginx "$(ls "$OUT/etc/nginx/sites-enabled" 2>/dev/null | paste -sd, -)"
printf '[drumee]   %-14s %s\n' zones "$(ls "$OUT/var/lib/bind" 2>/dev/null | paste -sd, -)"
printf '[drumee]   %-14s %s\n' credentials "$(ls "$OUT/etc/drumee/credential" 2>/dev/null | paste -sd, -)"
